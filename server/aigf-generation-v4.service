[Unit]
Description=AIGF V4 server-owned generation (isolated pilot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aigf-v4
Group=aigf-v4
WorkingDirectory=/opt/aigf-v4
LoadCredential=database-url:/etc/aigf-v4/database-url
LoadCredential=queue-token:/etc/aigf-v4/queue-token
ExecStart=/usr/bin/node /opt/aigf-v4/worker.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
